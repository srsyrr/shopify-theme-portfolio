{%- comment -%}
  Excerpt from a practice project (fictional brand Skinhale, Shopify development store).
  Base theme: Horizon 4.3.0 (c) Shopify. Only the code added for this project is shown (written with an AI coding agent, see the README); the rest of the theme is not published.
{%- endcomment -%}
{%- doc -%}
  Lists the product's Key ingredients, Skin type and How to use metafields with editable labels.
  A row renders only when its metafield has a value; when all three are empty the block outputs nothing.

  @example
  {% content_for 'block', type: 'product-details-list', id: 'product-details-list' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  assign key_ingredients = product.metafields.custom.key_ingredients.value
  assign skin_type = product.metafields.custom.skin_type.value
  assign how_to_use = product.metafields.custom.how_to_use.value
%}

{%- if key_ingredients != blank or skin_type != blank or how_to_use != blank -%}
  <div
    class="product-details-list spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <h2 class="product-details-list__heading {{ block_settings.heading_preset }}">{{ block_settings.heading | escape }}</h2>
    {%- endif -%}

    <dl class="product-details-list__rows">
      {%- if key_ingredients != blank -%}
        <div class="product-details-list__row">
          <dt class="product-details-list__label">{{ block_settings.key_ingredients_label | escape }}</dt>
          <dd class="product-details-list__value">{{ key_ingredients | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}
      {%- if skin_type != blank -%}
        <div class="product-details-list__row">
          <dt class="product-details-list__label">{{ block_settings.skin_type_label | escape }}</dt>
          <dd class="product-details-list__value">{{ skin_type | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if how_to_use != blank -%}
        <div class="product-details-list__row">
          <dt class="product-details-list__label">{{ block_settings.how_to_use_label | escape }}</dt>
          <dd class="product-details-list__value">{{ how_to_use | escape | newline_to_br }}</dd>
        </div>
      {%- endif -%}
    </dl>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-details-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    width: 100%;
    min-width: 0;
  }

  .product-details-list__heading {
    margin: 0;
  }

  .product-details-list__rows {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .product-details-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-2xs);
    padding-block: var(--padding-sm);
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .product-details-list__label {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
  }

  .product-details-list__value {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media screen and (min-width: 750px) {
    .product-details-list__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--gap-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_details_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.product_details_list_heading"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.heading_preset",
      "options": [
        { "value": "paragraph", "label": "t:options.paragraph" },
        { "value": "h3", "label": "t:options.h3" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" },
        { "value": "h6", "label": "t:options.h6" }
      ],
      "default": "h4"
    },
    {
      "type": "text",
      "id": "key_ingredients_label",
      "label": "t:settings.key_ingredients_label",
      "default": "t:text_defaults.key_ingredients"
    },
    {
      "type": "text",
      "id": "skin_type_label",
      "label": "t:settings.skin_type_label",
      "default": "t:text_defaults.skin_type"
    },
    {
      "type": "text",
      "id": "how_to_use_label",
      "label": "t:settings.how_to_use_label",
      "default": "t:text_defaults.how_to_use"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_details_list",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
