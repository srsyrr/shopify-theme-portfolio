diff --git a/assets/store-custom.css b/assets/store-custom.css
index f6a2b7a..8b408f2 100644
--- a/assets/store-custom.css
+++ b/assets/store-custom.css
@@ -1,5 +1,7 @@
 /* Store custom CSS: changes added on top of Horizon for this store.
-   Loaded after the theme's own styles in layout/theme.liquid. */
+   Loaded after the theme's own styles in layout/theme.liquid.
+   Rules outside a media query apply at every width; phone fixes live in the
+   max-width: 749px block (Horizon's own phone breakpoint), so desktop is unchanged. */
 
 /* Bigger, spaced-out wordmark in the header */
 .header-logo {
@@ -15,29 +17,52 @@
   line-height: 1.5;
 }
 
-/* Phones: compact header icons and buttons, taller product photos */
+/* Tablets (750-989 px) */
+@media screen and (min-width: 750px) and (max-width: 989px) {
+  /* Fix: the menu column was sized to its content ("auto"), so the long menu label
+     "Face care: cleansers, toners, ..." pushed search, account and cart past the right edge.
+     Let the menu column shrink instead; extra menu items move into Horizon's "More" list. */
+  .header__columns:has(.header__column--left header-menu) {
+    --header-left: minmax(0, 1fr) !important;
+  }
+}
+
+/* Phones */
 @media screen and (max-width: 749px) {
-  .header__icon--menu,
-  .header-actions__action,
-  .search-action .header-actions__action {
-    width: 24px;
-    height: 24px;
-    min-width: 0;
-    padding: 0;
+  /* Fix: header icons keep Horizon's own size (about 44 x 44 px), so they are easy to tap.
+     The old "compact header" rule shrank them to 24 px. Only the wordmark spacing is reduced
+     so the logo and four icons fit side by side on a 360 px screen. */
+  .header-logo {
+    letter-spacing: 0.08em;
   }
 
+  /* Fix: square photos instead of 3:4. Still larger than the theme default, but price,
+     options and Add to cart stay on the first screen. */
   .product-information__media .product-media {
-    aspect-ratio: 3 / 4 !important;
+    aspect-ratio: 1 / 1 !important;
   }
 
   .product-information__media .product-media__image {
     object-fit: cover !important;
   }
 
+  /* Fix: Add to cart at least 48 px tall with readable text (was 32 px / 12 px). */
   .product-form-buttons button[name='add'] {
-    height: 32px;
-    min-height: 32px;
-    padding-block: 0;
-    font-size: 0.75rem;
+    min-height: 48px;
+    font-size: 1rem;
+  }
+
+  /* Fix: titles are no longer cut to a fixed height that spills over the price.
+     Long titles show 3 lines and end with "…"; the full title is on the product page
+     and in the link's text for screen readers. Short titles keep the same 3-line slot,
+     so prices still line up. */
+  .product-card a.user-select-text > .text-block {
+    height: 4.5em;
+    overflow: hidden;
+    display: -webkit-box;
+    -webkit-box-orient: vertical;
+    -webkit-line-clamp: 3;
+    line-clamp: 3;
+    font-size: 0.9375rem;
   }
 }
diff --git a/sections/promo-banner.liquid b/sections/promo-banner.liquid
index a95f566..0e3ce6e 100644
--- a/sections/promo-banner.liquid
+++ b/sections/promo-banner.liquid
@@ -4,7 +4,7 @@
 {%- endcomment -%}
 {%- assign promo_product = section.settings.product -%}
 <div class="section section--page-width">
-  <div class="promo-banner">
+  <div class="promo-banner promo-banner--mobile-{{ section.settings.mobile_text_position }}">
     <div class="promo-banner__media">
       {%- if promo_product.featured_image -%}
         {{ promo_product.featured_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw', class: 'promo-banner__image' }}
@@ -64,6 +64,51 @@
   .promo-banner__text {
     margin: 16px 0 24px;
   }
+
+  /* Phones: the 1,440 px layout (fixed 440 px box, 72 px from the edge) does not fit.
+     Default: text goes below the photo. Merchant option: keep it on the photo,
+     as a full-width box at the bottom with 16 px margins. */
+  @media screen and (max-width: 749px) {
+    .promo-banner {
+      margin-block: 24px;
+    }
+
+    .promo-banner__media {
+      height: auto;
+      aspect-ratio: 4 / 3;
+    }
+
+    .promo-banner__content {
+      width: auto;
+      padding: 20px;
+    }
+
+    .promo-banner--mobile-below .promo-banner__content {
+      position: static;
+      padding-inline: 0;
+      background: none;
+    }
+
+    /* Taller photo, so the text box at the bottom still leaves the top of the photo visible. */
+    .promo-banner--mobile-overlay .promo-banner__media {
+      aspect-ratio: 4 / 5;
+    }
+
+    .promo-banner--mobile-overlay .promo-banner__content {
+      top: auto;
+      right: 16px;
+      bottom: 16px;
+      left: 16px;
+    }
+
+    .promo-banner__heading {
+      font-size: 1.75rem;
+    }
+
+    .promo-banner__text {
+      margin: 8px 0 16px;
+    }
+  }
 {% endstylesheet %}
 
 {% schema %}
@@ -75,7 +120,17 @@
     { "type": "product", "id": "product", "label": "Product (photo and link)" },
     { "type": "text", "id": "heading", "label": "Heading", "default": "Your new everyday ritual" },
     { "type": "textarea", "id": "text", "label": "Text", "default": "A calm three-step routine for skin that feels balanced from morning to night." },
-    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the routine" }
+    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the routine" },
+    {
+      "type": "select",
