{%- comment -%}
  Promo banner: a product photo with a text box on top of it.
  Custom section, not part of Horizon. Uses the chosen product's photo and link.
{%- endcomment -%}
{%- assign promo_product = section.settings.product -%}
<div class="section section--page-width">
  <div class="promo-banner promo-banner--mobile-{{ section.settings.mobile_text_position }}">
    <div class="promo-banner__media">
      {%- if promo_product.featured_image -%}
        {{ promo_product.featured_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw', class: 'promo-banner__image' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'promo-banner__image' }}
      {%- endif -%}
    </div>
    <div class="promo-banner__content">
      <h2 class="promo-banner__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="promo-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button promo-banner__button" href="{{ promo_product.url | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .promo-banner {
    position: relative;
    margin-block: 40px;
  }

  .promo-banner__media {
    height: 520px;
    border-radius: 16px;
    overflow: hidden;
  }

  .promo-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo-banner__content {
    position: absolute;
    top: 72px;
    left: 72px;
    width: 440px;
    padding: 32px;
    border-radius: 12px;
    background: var(--color-background);
  }

  .promo-banner__heading {
    margin: 0;
    font-size: 2.75rem;
    line-height: 1.1;
  }

  .promo-banner__text {
    margin: 16px 0 24px;
  }

  /* Phones: the 1,440 px layout (fixed 440 px box, 72 px from the edge) does not fit.
     Default: text goes below the photo. Merchant option: keep it on the photo,
     as a full-width box at the bottom with 16 px margins. */
  @media screen and (max-width: 749px) {
    .promo-banner {
      margin-block: 24px;
    }

    .promo-banner__media {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .promo-banner__content {
      width: auto;
      padding: 20px;
    }

    .promo-banner--mobile-below .promo-banner__content {
      position: static;
      padding-inline: 0;
      background: none;
    }

    /* Taller photo, so the text box at the bottom still leaves the top of the photo visible. */
    .promo-banner--mobile-overlay .promo-banner__media {
      aspect-ratio: 4 / 5;
    }

    .promo-banner--mobile-overlay .promo-banner__content {
      top: auto;
      right: 16px;
      bottom: 16px;
      left: 16px;
    }

    .promo-banner__heading {
      font-size: 1.75rem;
    }

    .promo-banner__text {
      margin: 8px 0 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "promo-banner-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (photo and link)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your new everyday ritual" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A calm three-step routine for skin that feels balanced from morning to night." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the routine" },
    {
      "type": "select",
      "id": "mobile_text_position",
      "label": "Text on phones",
      "options": [
        { "value": "below", "label": "Below the photo" },
        { "value": "overlay", "label": "On the photo" }
      ],
      "default": "below"
    }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}
